# DealCheck environment. Copy to .env.local and fill in what you have.
# Any missing key = that service runs in mock mode. The app always runs.

# Public base URL (Stripe redirects and email links). Your Vercel URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MarketCheck: comparable listings + predicted price (mock comps without it)
MARKETCHECK_API_KEY=
# Optional: your plan's price per MarketCheck call, for cost logging (e.g. 0.01)
MARKETCHECK_COST_PER_CALL_USD=

# Anthropic: report writing, reply coach, listing reading (template text without it)
ANTHROPIC_API_KEY=

# Stripe, test mode (mock checkout page without STRIPE_SECRET_KEY)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase: orders, reports, coach threads, limits, cache (in-memory store without it)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: delivery email (logged to the console without it)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Set to 1 to force mock mode for everything, even with keys set (used by e2e tests)
DEALCHECK_OFFLINE=
